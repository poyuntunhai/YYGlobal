APP_ENV=development
AUTH_ENABLED=false
LOCAL_OWNER_ID=local-admin

# 本地直接运行可使用 SQLite；Docker Compose 会覆盖为 PostgreSQL。
DATABASE_URL=sqlite+aiosqlite:///./data/yyglobal.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# auto 优先使用阿里云百炼，其次 OpenAI；两个 Key 都留空时使用本地 Agent 模式。
LLM_PROVIDER=auto
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_REASONING_MODEL=qwen-plus
DASHSCOPE_EXTRACTION_MODEL=qwen-vl-plus
PROGRAM_DISCOVERY_MODEL=qwen-plus
PROGRAM_VERIFICATION_MODEL=qwen-vl-plus
LLM_REQUEST_TIMEOUT_SECONDS=60

# 可选的 OpenAI Provider。
OPENAI_API_KEY=
LLM_REASONING_MODEL=gpt-5.6-terra
LLM_EXTRACTION_MODEL=gpt-5.6-luna
LLM_DEFAULT_REASONING_EFFORT=medium

AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TOOL_TIMEOUT_SECONDS=30
AGENT_MAX_TOOL_RETRIES=2
AGENT_CONTEXT_TOKEN_BUDGET=40000
AGENT_TRACE_RETENTION_DAYS=30

MCP_ENABLED=true
OFFICIAL_FETCH_TIMEOUT_SECONDS=20
OFFICIAL_FETCH_USER_AGENT=YYGlobalBot/0.1
CORS_ORIGINS_CSV=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api
